# Copy to .env on the server and fill in. Never commit .env.
BOT_TOKEN=123456:ABC-from-BotFather
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_USER=bot
POSTGRES_DB=channelcheck

# Your Telegram ID(s), comma-separated: allowed to use /refund
ADMIN_IDS=
# Chat ID where the worker sends error alerts (your own ID works)
ALERT_CHAT_ID=
# Shown in /paysupport, e.g. @your_support_username
SUPPORT_CONTACT=

FREE_CHECKS_ON_START=1
CHECKS_PER_HOUR_LIMIT=10
CACHE_HOURS=6
OWN_REPEAT_HOURS=24
